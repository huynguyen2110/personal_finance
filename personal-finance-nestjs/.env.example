# PostgreSQL (Laragon mặc định: postgres/postgres). Tạo DB personal_finance trước khi migrate.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/personal_finance"
# Neon: dùng chuỗi kết nối pooled của project, thêm ?sslmode=require, VD:
# DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Cổng API và các origin frontend được phép gọi (ngăn cách bằng dấu phẩy)
PORT=4000
ALLOW_CORS="http://localhost:3002,http://localhost:3003"

# Chuỗi ngẫu nhiên >= 32 ký tự để ký JWT
JWT_SECRET=""
# Hạn access token (định dạng của jsonwebtoken) và refresh token (ngày)
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_DAYS=30

# Tài khoản đăng nhập (tạo khi chạy `npm run seed`)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""

# ─── Đọc email thông báo của ngân hàng qua IMAP ───
# Gmail: bật Xác minh 2 bước rồi tạo "Mật khẩu ứng dụng" tại https://myaccount.google.com/apppasswords
# (KHÔNG dùng mật khẩu Gmail thường).
IMAP_HOST="imap.gmail.com"
IMAP_PORT="993"
IMAP_USER=""
IMAP_PASSWORD=""
IMAP_MAILBOX="INBOX"
# Lọc người gửi theo từng ngân hàng (chuỗi con của địa chỉ gửi)
VCB_EMAIL_FROM="vietcombank"
CAKE_EMAIL_FROM="cake.vn"
ACB_EMAIL_FROM="acb.com.vn"
# Tự đọc email mỗi N phút khi API chạy (0 = tắt)
EMAIL_POLL_MINUTES="3"

# Secret cho http://localhost:4000/api/cron/sync?secret=... (tùy chọn: gọi đọc email từ Task Scheduler)
CRON_SECRET=""
