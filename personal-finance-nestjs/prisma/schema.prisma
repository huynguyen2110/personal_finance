generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Tiền VND lưu dạng BigInt (số nguyên đồng). Khi trả JSON đổi sang Number (xem src/lib/money.ts).

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens RefreshToken[]
}

// Refresh token (JWT access token sống ngắn, refresh token sống dài, xoay vòng mỗi lần dùng).
// Chỉ lưu mã băm sha256 — lộ DB cũng không dùng được token.
model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  tokenHash String   @unique @db.VarChar(64)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum AccountType {
  BANK
  CASH
}

model Account {
  id             Int         @id @default(autoincrement())
  type           AccountType @default(BANK)
  name           String
  bankName       String?
  accountNumber  String?     @unique
  // Số dư hiện tại = số dư đầu kỳ + tổng thu − tổng chi của tài khoản,
  // trừ khi ngân hàng có báo số dư (VD email ACB) → dùng số dư ngân hàng báo gần nhất
  openingBalance BigInt      @default(0)
  bankBalance    BigInt?
  bankBalanceAt  DateTime?
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  transactions   Transaction[]
  goalsHeld      SavingsGoal[]          @relation("GoalHolding")
  goalsFunded    SavingsGoal[]          @relation("GoalSource")
  // Nhóm chi tiêu/thu nhập tài khoản này thường dùng (gợi ý & tự phân loại)
  categoryGroups AccountCategoryGroup[]
  rules          CategoryRule[]
}

enum CategoryKind {
  EXPENSE
  INCOME
}

model Category {
  id        Int          @id @default(autoincrement())
  name      String
  kind      CategoryKind
  icon      String       @default("Tag")
  color     String       @default("#64748B")
  isSystem  Boolean      @default(false)
  sortOrder Int          @default(0)
  // Danh mục 2 cấp: danh mục con trỏ về danh mục cha cùng loại (cha luôn là cấp cao nhất)
  parentId  Int?
  // Nhóm (tầng trên danh mục cha): chỉ danh mục cấp cao nhất mới thuộc nhóm, con đi theo cha
  groupId   Int?
  createdAt DateTime     @default(now())

  parent           Category?       @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children         Category[]      @relation("CategoryTree")
  group            CategoryGroup?  @relation("GroupCategories", fields: [groupId], references: [id], onDelete: SetNull)
  defaultForGroups CategoryGroup[] @relation("GroupDefault")
  transactions     Transaction[]
  rules            CategoryRule[]
  budgets          Budget[]

  @@unique([name, kind])
  @@index([parentId])
  @@index([groupId])
}

// Nhóm chi tiêu / thu nhập: gom nhiều danh mục cha, gán cho tài khoản ngân hàng thường chi cho nhóm đó.
// Dùng để gợi ý danh mục khi chọn tay, giới hạn quy tắc theo tài khoản và tự phân loại khi không khớp quy tắc.
model CategoryGroup {
  id                Int          @id @default(autoincrement())
  name              String
  kind              CategoryKind
  icon              String       @default("Layers")
  color             String       @default("#64748B")
  sortOrder         Int          @default(0)
  // Danh mục nhận giao dịch khi tài khoản chỉ gán đúng một nhóm (loại này) và không quy tắc nào khớp
  defaultCategoryId Int?
  createdAt         DateTime     @default(now())

  defaultCategory Category?              @relation("GroupDefault", fields: [defaultCategoryId], references: [id], onDelete: SetNull)
  categories      Category[]             @relation("GroupCategories")
  accounts        AccountCategoryGroup[]

  @@unique([name, kind])
}

// Tài khoản ↔ nhóm (nhiều-nhiều)
model AccountCategoryGroup {
  accountId Int
  groupId   Int

  account Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  group   CategoryGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([accountId, groupId])
  @@index([groupId])
}

enum MatchType {
  CONTAINS
  REGEX
}

// Quy tắc chỉ áp dụng cho giao dịch cùng chiều với loại danh mục (chi ↔ OUT, thu ↔ IN)
model CategoryRule {
  id         Int       @id @default(autoincrement())
  // CONTAINS: một hoặc nhiều từ khóa, ngăn cách bằng dấu phẩy (khớp nguyên từ, không phân biệt dấu/hoa thường)
  // REGEX: biểu thức chính quy, chạy trên nội dung đã bỏ dấu + viết hoa
  pattern    String
  matchType  MatchType @default(CONTAINS)
  categoryId Int
  priority   Int       @default(100) // số nhỏ chạy trước
  isActive   Boolean   @default(true)
  // Chỉ áp dụng cho giao dịch của một tài khoản (null = mọi tài khoản)
  accountId  Int?
  createdAt  DateTime  @default(now())

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  account  Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

enum TxnSource {
  EMAIL // đọc từ email thông báo của ngân hàng (Vietcombank, Cake…)
  MANUAL // nhập tay
  IMPORT // nhập từ file / dữ liệu có sẵn (VD dữ liệu demo)
}

enum TxnDirection {
  IN
  OUT
}

enum CategorizedBy {
  RULE // khớp quy tắc từ khóa
  MANUAL // người dùng tự chọn
  NONE // chưa phân loại
  ACCOUNT // không khớp quy tắc, gán theo nhóm duy nhất của tài khoản
}

model Transaction {
  id               Int           @id @default(autoincrement())
  accountId        Int
  // Khóa chống trùng theo nguồn, VD "vcb-email:<số lệnh giao dịch>", "cake-email:<mã giao dịch>"
  externalId       String?       @unique @db.VarChar(100)
  source           TxnSource
  direction        TxnDirection
  amount           BigInt
  content          String        @db.Text
  referenceCode    String?
  transactionDate  DateTime
  categoryId       Int?
  categorizedBy    CategorizedBy @default(NONE)
  note             String?       @db.Text
  // Loại khỏi thống kê (VD: chuyển tiền giữa các tài khoản của chính mình)
  excludeFromStats Boolean       @default(false)
  // Chuyển khoản nội bộ: hai giao dịch (ra ở TK này, vào ở TK kia) trỏ vào nhau
  transferPairId   Int?          @unique
  // Người dùng xác nhận "không phải chuyển nội bộ" → không tự ghép lại nữa
  transferIgnored  Boolean       @default(false)
  rawPayload       Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  account          Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category         Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  transferPair     Transaction?      @relation("TransferPair", fields: [transferPairId], references: [id], onDelete: SetNull)
  transferPairOf   Transaction?      @relation("TransferPair")
  goalContribution GoalContribution?

  @@index([transactionDate])
  @@index([amount, transactionDate])
  @@index([categoryId, transactionDate])
  @@index([accountId, transactionDate])
}

model Budget {
  id         Int    @id @default(autoincrement())
  categoryId Int
  // "YYYY-MM", hoặc "*" = ngân sách mặc định áp dụng cho tháng chưa đặt riêng
  month      String @db.VarChar(7)
  amount     BigInt

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, month])
}

// ─── Mục tiêu tiết kiệm ───
// Mục tiêu là "hũ" ảo: web không chuyển tiền thật, chỉ ghi lại các lần bạn nạp/rút
// (có thể gắn với giao dịch chuyển tiền thật để không bị tính là khoản chi).

enum GoalJar {
  SAFETY // An toàn tài chính (quỹ khẩn cấp)
  PURCHASE // Mua sắm lớn
  EXPERIENCE // Trải nghiệm & du lịch
  INVESTMENT // Đầu tư / hưu trí
  SELF // Nâng tầm bản thân
  OTHER
}

enum GoalPriority {
  HIGH // Ưu tiên cao nhất
  NORMAL // Bình thường
  FLEXIBLE // Linh hoạt, tùy dòng tiền dư
}

model SavingsGoal {
  id               Int          @id @default(autoincrement())
  name             String
  icon             String       @default("PiggyBank")
  jar              GoalJar      @default(OTHER)
  priority         GoalPriority @default(NORMAL)
  // Quỹ duy trì (VD quỹ khẩn cấp): tiến độ tính theo số còn trong quỹ → tiêu bớt thì quay lại tích lũy.
  // false = quỹ một lần (VD mua điện thoại): đạt là xong, tiêu không làm giảm tiến độ.
  ongoing          Boolean      @default(false)
  targetAmount     BigInt
  // Tháng cần đạt "YYYY-MM" (null = không đặt hạn)
  deadline         String?      @db.VarChar(7)
  // Kế hoạch nạp định kỳ: số tiền/tháng + ngày trong tháng (để nhắc, web không tự chuyển tiền)
  monthlyPlan      BigInt?
  planDay          Int?
  sourceAccountId  Int?
  // Nơi giữ tiền: một tài khoản trong web, hoặc tên tự nhập (VD "Cake - Hũ tiết kiệm")
  holdingAccountId Int?
  holdingName      String?
  // Lãi suất %/năm × 100 (550 = 5,50%/năm)
  interestRateBp   Int?
  note             String?      @db.Text
  completedAt      DateTime?
  archivedAt       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  sourceAccount  Account?           @relation("GoalSource", fields: [sourceAccountId], references: [id], onDelete: SetNull)
  holdingAccount Account?           @relation("GoalHolding", fields: [holdingAccountId], references: [id], onDelete: SetNull)
  contributions  GoalContribution[]
}

enum ContributionKind {
  OPENING // số tiền đã có khi tạo mục tiêu
  DEPOSIT // nạp thêm
  WITHDRAW // rút ra
  INTEREST // tiền lãi nhận được
  SPEND // tiêu tiền của quỹ cho đúng mục đích (VD đã mua laptop) — không làm giảm tiến độ tích lũy
}

model GoalContribution {
  id            Int              @id @default(autoincrement())
  goalId        Int
  kind          ContributionKind
  amount        BigInt // luôn dương; chiều do kind quyết định
  date          DateTime
  note          String?          @db.Text
  // Gắn với giao dịch chuyển tiền thật (mỗi giao dịch gắn tối đa một lần)
  transactionId Int?             @unique
  // Web đã tự loại giao dịch gắn kèm khỏi thống kê → bỏ gắn thì trả lại như cũ
  excludedTxn   Boolean          @default(false)
  createdAt     DateTime         @default(now())

  goal        SavingsGoal  @relation(fields: [goalId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([goalId, date])
}

// Trạng thái nội bộ dạng key–value (VD: UID email đã đọc tới đâu, kết quả lần đọc email gần nhất)
model AppState {
  key       String   @id @db.VarChar(100)
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}
